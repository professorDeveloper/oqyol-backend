generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DRIVER
  ADMIN
}

enum AppType {
  PASSENGER
  DRIVER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DriverStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum OrderStatus {
  OPEN
  ACCEPTED
  ARRIVED
  FOUND
  CANCELLED
  EXPIRED
  DISPUTED
}

enum RideType {
  SOLO
  CARPOOL
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AnnouncementStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WalletTxType {
  TOPUP
  HOLD
  CAPTURE
  RELEASE
  BONUS
}

enum HoldStatus {
  HELD
  CAPTURED
  RELEASED
}

enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum ReferralStatus {
  PENDING
  COMPLETED
}

enum NotificationType {
  ORDER
  OFFER
  WALLET
  SYSTEM
  REFERRAL
}

enum RiskEventType {
  CANCEL
  INVALID_ARRIVAL
  DISPUTE
  FAKE_GPS
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(USER)
  registeredApp AppType @default(PASSENGER) @map("registered_app")
  avatarUrl    String?  @map("avatar_url")
  referralCode String   @unique @map("referral_code")
  referredBy   String?  @map("referred_by")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  referrer             User?                @relation("Referral", fields: [referredBy], references: [id])
  referrals            User[]               @relation("Referral")
  sessions             UserSession[]
  driverApplications   DriverApplication[]  @relation("Applicant")
  reviewedApplications DriverApplication[]  @relation("Reviewer")
  driverProfile        DriverProfile?
  wallet               Wallet?
  passengerOrders      Order[]              @relation("Passenger")
  driverOrders         Order[]              @relation("Driver")
  cancelledOrders      Order[]              @relation("Canceller")
  offers               Offer[]
  announcements        DriverAnnouncement[]
  locationProofs       OrderLocationProof[]
  statusChanges        OrderStatusHistory[] @relation("ChangedBy")
  givenRatings         Rating[]             @relation("Rater")
  receivedRatings      Rating[]             @relation("Rated")
  referralsSent        Referral[]           @relation("Referrer")
  referralsReceived    Referral[]           @relation("Referred")
  disputesOpened       Dispute[]            @relation("DisputeOpener")
  disputesResolved     Dispute[]            @relation("DisputeResolver")
  notifications        Notification[]
  riskEvents           RiskEvent[]
  adminActions         AdminAction[]

  @@index([phone])
  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  deviceName       String   @map("device_name")
  deviceId         String   @map("device_id")
  refreshTokenHash String   @map("refresh_token_hash")
  lastActiveAt     DateTime @default(now()) @map("last_active_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("user_sessions")
}

model DriverApplication {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  licenseFrontUrl String            @map("license_front_url")
  licenseBackUrl  String            @map("license_back_url")
  passportUrl     String            @map("passport_url")
  status          ApplicationStatus @default(PENDING)
  reviewedBy      String?           @map("reviewed_by")
  rejectionReason String?           @map("rejection_reason")
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  user     User  @relation("Applicant", fields: [userId], references: [id])
  reviewer User? @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@index([userId, status])
  @@map("driver_applications")
}

model DriverProfile {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  status         DriverStatus @default(ACTIVE)
  smokingAllowed Boolean      @default(false) @map("smoking_allowed")
  acAvailable    Boolean      @default(false) @map("ac_available")
  musicAllowed   Boolean      @default(true) @map("music_allowed")
  petsAllowed    Boolean      @default(false) @map("pets_allowed")
  bio            String?
  avgRating      Decimal?     @map("avg_rating") @db.Decimal(2, 1)
  totalRatings   Int          @default(0) @map("total_ratings")
  suspendedUntil DateTime?    @map("suspended_until")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  vehicle Vehicle?

  @@map("driver_profiles")
}

model Vehicle {
  id          String   @id @default(uuid())
  driverId    String   @unique @map("driver_id")
  brand       String
  model       String
  color       String
  plateNumber String   @unique @map("plate_number")
  year        Int
  seatCount   Int      @map("seat_count")
  photoUrl    String?  @map("photo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

model Region {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String? @unique
  lat      Float
  lng      Float
  radiusKm Float   @map("radius_km")
  isActive Boolean @default(true) @map("is_active")

  fromRoutes Route[]    @relation("FromRegion")
  toRoutes   Route[]    @relation("ToRegion")
  districts  District[]

  @@map("regions")
}

model District {
  id       String  @id @default(uuid())
  regionId String  @map("region_id")
  name     String
  isActive Boolean @default(true) @map("is_active")

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, name])
  @@index([regionId])
  @@map("districts")
}

model Route {
  id                   String  @id @default(uuid())
  fromRegionId         String  @map("from_region_id")
  toRegionId           String  @map("to_region_id")
  distanceKm           Float   @map("distance_km")
  estimatedDurationMin Int     @map("estimated_duration_min")
  basePrice            Decimal @map("base_price") @db.Decimal(12, 2)
  isActive             Boolean @default(true) @map("is_active")

  fromRegion    Region               @relation("FromRegion", fields: [fromRegionId], references: [id])
  toRegion      Region               @relation("ToRegion", fields: [toRegionId], references: [id])
  orders        Order[]
  announcements DriverAnnouncement[]

  @@map("routes")
}

model Order {
  id                 String      @id @default(uuid())
  passengerId        String      @map("passenger_id")
  driverId           String?     @map("driver_id")
  routeId            String      @map("route_id")
  status             OrderStatus @default(OPEN)
  rideType           RideType    @default(SOLO) @map("ride_type")
  seatsRequested     Int         @default(1) @map("seats_requested")
  passengerPrice     Decimal     @map("passenger_price") @db.Decimal(12, 2)
  finalPrice         Decimal?    @map("final_price") @db.Decimal(12, 2)
  otpCode            String?     @map("otp_code")
  scheduledAt        DateTime?   @map("scheduled_at")
  acceptedAt         DateTime?   @map("accepted_at")
  arrivedAt          DateTime?   @map("arrived_at")
  foundAt            DateTime?   @map("found_at")
  cancelledAt        DateTime?   @map("cancelled_at")
  cancelledBy        String?     @map("cancelled_by")
  cancellationReason String?     @map("cancellation_reason")
  expiresAt          DateTime    @map("expires_at")
  createdAt          DateTime    @default(now()) @map("created_at")

  passenger      User                 @relation("Passenger", fields: [passengerId], references: [id])
  driver         User?                @relation("Driver", fields: [driverId], references: [id])
  canceller      User?                @relation("Canceller", fields: [cancelledBy], references: [id])
  route          Route                @relation(fields: [routeId], references: [id])
  offers         Offer[]
  statusHistory  OrderStatusHistory[]
  locationProofs OrderLocationProof[]
  commissionHold CommissionHold?
  ratings        Rating[]
  disputes       Dispute[]

  @@index([status, routeId])
  @@index([passengerId, status])
  @@index([driverId, status])
  @@index([expiresAt])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  changedBy String      @map("changed_by")
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  order   Order @relation(fields: [orderId], references: [id])
  changer User  @relation("ChangedBy", fields: [changedBy], references: [id])

  @@map("order_status_history")
}

model Offer {
  id           String      @id @default(uuid())
  orderId      String      @map("order_id")
  driverId     String      @map("driver_id")
  offeredPrice Decimal     @map("offered_price") @db.Decimal(12, 2)
  status       OfferStatus @default(PENDING)
  message      String?
  respondedAt  DateTime?   @map("responded_at")
  expiresAt    DateTime    @map("expires_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id])
  driver User  @relation(fields: [driverId], references: [id])

  @@index([orderId, status])
  @@index([driverId, status])
  @@index([expiresAt])
  @@map("offers")
}

model DriverAnnouncement {
  id             String             @id @default(uuid())
  driverId       String             @map("driver_id")
  routeId        String             @map("route_id")
  departureTime  DateTime           @map("departure_time")
  availableSeats Int                @map("available_seats")
  pricePerSeat   Decimal            @map("price_per_seat") @db.Decimal(12, 2)
  status         AnnouncementStatus @default(ACTIVE)
  note           String?
  expiresAt      DateTime           @map("expires_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  driver User  @relation(fields: [driverId], references: [id])
  route  Route @relation(fields: [routeId], references: [id])

  @@index([status, routeId])
  @@index([driverId, status])
  @@map("driver_announcements")
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  heldAmount Decimal  @default(0) @map("held_amount") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
  holds        CommissionHold[]

  @@map("wallets")
}

model WalletTransaction {
  id          String       @id @default(uuid())
  walletId    String       @map("wallet_id")
  type        WalletTxType
  amount      Decimal      @db.Decimal(12, 2)
  referenceId String?      @map("reference_id")
  description String
  createdAt   DateTime     @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model CommissionHold {
  id         String     @id @default(uuid())
  orderId    String     @unique @map("order_id")
  walletId   String     @map("wallet_id")
  amount     Decimal    @db.Decimal(12, 2)
  status     HoldStatus @default(HELD)
  heldAt     DateTime   @default(now()) @map("held_at")
  resolvedAt DateTime?  @map("resolved_at")

  order  Order  @relation(fields: [orderId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([status])
  @@map("commission_holds")
}

model Rating {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  raterId   String   @map("rater_id")
  ratedId   String   @map("rated_id")
  score     Int
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])
  rater User  @relation("Rater", fields: [raterId], references: [id])
  rated User  @relation("Rated", fields: [ratedId], references: [id])

  @@index([ratedId])
  @@index([orderId])
  @@map("ratings")
}

model Referral {
  id          String         @id @default(uuid())
  referrerId  String         @map("referrer_id")
  referredId  String         @map("referred_id")
  bonusAmount Decimal        @map("bonus_amount") @db.Decimal(12, 2)
  status      ReferralStatus @default(PENDING)
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referred User @relation("Referred", fields: [referredId], references: [id])

  @@map("referrals")
}

model OrderLocationProof {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  driverId          String   @map("driver_id")
  lat               Float
  lng               Float
  accuracyMeters    Float    @map("accuracy_meters")
  distanceToPickupM Float    @map("distance_to_pickup_m")
  isValid           Boolean  @map("is_valid")
  checkedAt         DateTime @map("checked_at")

  order  Order @relation(fields: [orderId], references: [id])
  driver User  @relation(fields: [driverId], references: [id])

  @@map("order_location_proofs")
}

model Dispute {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  openedBy    String        @map("opened_by")
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedBy  String?       @map("resolved_by")
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id])
  opener   User  @relation("DisputeOpener", fields: [openedBy], references: [id])
  resolver User? @relation("DisputeResolver", fields: [resolvedBy], references: [id])

  @@index([status])
  @@map("disputes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model RiskEvent {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  eventType RiskEventType @map("event_type")
  severity  Severity
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("risk_events")
}

model AdminAction {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  targetId  String   @map("target_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@map("admin_actions")
}
